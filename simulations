"""
ANOAP — Autonomous Ocean-Aerospace Platform
Version 1.0 — Educational Engineering Simulator

This model is intentionally simplified.
It is designed to help investigate the physics of a hypothetical
multi-domain vehicle operating in:

    1. AIR
    2. OCEAN SURFACE
    3. UNDERWATER

The model does NOT simulate a nuclear reactor.

Main outputs:
    - Lift
    - Drag
    - Buoyancy
    - Required thrust
    - Electrical power
    - Endurance
    - Range
    - Energy consumption
    - Vehicle performance graphs

Author: Independent Research Project
"""

# ============================================================
# IMPORTS
# ============================================================

import math
import csv
from dataclasses import dataclass
from pathlib import Path

import numpy as np
import matplotlib.pyplot as plt


# ============================================================
# CONSTANTS
# ============================================================

G = 9.80665                 # gravitational acceleration, m/s²
RHO_AIR = 1.225             # sea-level air density, kg/m³
RHO_WATER = 1025.0          # seawater density, kg/m³


# ============================================================
# VEHICLE PARAMETERS
# ============================================================

@dataclass
class Vehicle:
    # Mass
    mass_kg: float = 25.0

    # Geometry
    length_m: float = 2.0
    width_m: float = 0.8
    height_m: float = 0.35

    # Wing
    wing_area_m2: float = 1.5

    # Aerodynamics
    cd_air: float = 0.08
    cl_max: float = 1.2

    # Surface / underwater hydrodynamics
    cd_surface: float = 0.06
    cd_underwater: float = 0.35

    # Frontal areas
    frontal_area_air_m2: float = 0.25
    frontal_area_water_m2: float = 0.28

    # Propulsion efficiencies
    propulsive_efficiency_air: float = 0.65
    propulsive_efficiency_surface: float = 0.55
    propulsive_efficiency_underwater: float = 0.50

    # Electrical system
    battery_energy_kwh: float = 20.0

    # Battery usable fraction
    battery_usable_fraction: float = 0.90

    # Hotel / electronics load
    hotel_power_kw: float = 0.15

    # Vehicle volume
    displacement_volume_m3: float = 0.20


# ============================================================
# ENVIRONMENT
# ============================================================

@dataclass
class Environment:
    air_density: float = RHO_AIR
    water_density: float = RHO_WATER
    gravity: float = G


# ============================================================
# BASIC PHYSICS
# ============================================================

def vehicle_weight(vehicle: Vehicle, env: Environment) -> float:
    """
    Weight of vehicle in Newtons.
    """
    return vehicle.mass_kg * env.gravity


def buoyancy_force(vehicle: Vehicle, env: Environment) -> float:
    """
    Archimedes' principle:

        Fb = rho * g * V

    Returns buoyancy in Newtons.
    """
    return (
        env.water_density
        * env.gravity
        * vehicle.displacement_volume_m3
    )


def aerodynamic_drag(
    vehicle: Vehicle,
    velocity_mps: float,
    air_density: float
) -> float:
    """
    Aerodynamic drag:

        D = 0.5 * rho * V² * Cd * A
    """

    return (
        0.5
        * air_density
        * velocity_mps ** 2
        * vehicle.cd_air
        * vehicle.frontal_area_air_m2
    )


def hydrodynamic_drag(
    vehicle: Vehicle,
    velocity_mps: float,
    water_density: float,
    cd: float = None
) -> float:
    """
    Hydrodynamic drag:

        D = 0.5 * rho * V² * Cd * A
    """

    if cd is None:
        cd = vehicle.cd_underwater

    return (
        0.5
        * water_density
        * velocity_mps ** 2
        * cd
        * vehicle.frontal_area_water_m2
    )


def lift_force(
    vehicle: Vehicle,
    velocity_mps: float,
    air_density: float,
    cl: float
) -> float:
    """
    Lift:

        L = 0.5 * rho * V² * S * Cl
    """

    return (
        0.5
        * air_density
        * velocity_mps ** 2
        * vehicle.wing_area_m2
        * cl
    )


# ============================================================
# FLIGHT MODEL
# ============================================================

def required_lift_coefficient(
    vehicle: Vehicle,
    velocity_mps: float,
    env: Environment
) -> float:
    """
    Calculates the lift coefficient required for level flight.

        L = W

    Therefore:

        Cl = W / (0.5 * rho * V² * S)
    """

    if velocity_mps <= 0:
        return float("inf")

    weight = vehicle_weight(vehicle, env)

    denominator = (
        0.5
        * env.air_density
        * velocity_mps ** 2
        * vehicle.wing_area_m2
    )

    return weight / denominator


def flight_performance(
    vehicle: Vehicle,
    velocity_mps: float,
    env: Environment
) -> dict:

    if velocity_mps <= 0:
        return {
            "velocity": 0,
            "lift": 0,
            "drag": 0,
            "cl": float("inf"),
            "thrust": 0,
            "mechanical_power": 0,
            "electrical_power": vehicle.hotel_power_kw
        }

    weight = vehicle_weight(vehicle, env)

    cl = required_lift_coefficient(
        vehicle,
        velocity_mps,
        env
    )

    lift = lift_force(
        vehicle,
        velocity_mps,
        env.air_density,
        cl
    )

    drag = aerodynamic_drag(
        vehicle,
        velocity_mps,
        env.air_density
    )

    # Required thrust approximately equals drag
    thrust = drag

    mechanical_power_w = thrust * velocity_mps

    electrical_power_w = (
        mechanical_power_w
        / vehicle.propulsive_efficiency_air
    )

    total_power_kw = (
        electrical_power_w / 1000
        + vehicle.hotel_power_kw
    )

    return {
        "velocity": velocity_mps,
        "weight": weight,
        "lift": lift,
        "drag": drag,
        "cl": cl,
        "thrust": thrust,
        "mechanical_power": mechanical_power_w / 1000,
        "electrical_power": total_power_kw
    }


# ============================================================
# SURFACE MODEL
# ============================================================

def surface_performance(
    vehicle: Vehicle,
    velocity_mps: float,
    env: Environment
) -> dict:

    if velocity_mps <= 0:
        return {
            "velocity": 0,
            "buoyancy": buoyancy_force(vehicle, env),
            "drag": 0,
            "thrust": 0,
            "mechanical_power": 0,
            "electrical_power": vehicle.hotel_power_kw
        }

    buoyancy = buoyancy_force(vehicle, env)

    drag = hydrodynamic_drag(
        vehicle,
        velocity_mps,
        env.water_density,
        vehicle.cd_surface
    )

    thrust = drag

    mechanical_power_w = thrust * velocity_mps

    electrical_power_w = (
        mechanical_power_w
        / vehicle.propulsive_efficiency_surface
    )

    total_power_kw = (
        electrical_power_w / 1000
        + vehicle.hotel_power_kw
    )

    return {
        "velocity": velocity_mps,
        "buoyancy": buoyancy,
        "drag": drag,
        "thrust": thrust,
        "mechanical_power": mechanical_power_w / 1000,
        "electrical_power": total_power_kw
    }


# ============================================================
# UNDERWATER MODEL
# ============================================================

def underwater_performance(
    vehicle: Vehicle,
    velocity_mps: float,
    env: Environment
) -> dict:

    if velocity_mps <= 0:
        return {
            "velocity": 0,
            "buoyancy": buoyancy_force(vehicle, env),
            "drag": 0,
            "thrust": 0,
            "mechanical_power": 0,
            "electrical_power": vehicle.hotel_power_kw
        }

    buoyancy = buoyancy_force(vehicle, env)

    drag = hydrodynamic_drag(
        vehicle,
        velocity_mps,
        env.water_density,
        vehicle.cd_underwater
    )

    thrust = drag

    mechanical_power_w = thrust * velocity_mps

    electrical_power_w = (
        mechanical_power_w
        / vehicle.propulsive_efficiency_underwater
    )

    total_power_kw = (
        electrical_power_w / 1000
        + vehicle.hotel_power_kw
    )

    return {
        "velocity": velocity_mps,
        "buoyancy": buoyancy,
        "drag": drag,
        "thrust": thrust,
        "mechanical_power": mechanical_power_w / 1000,
        "electrical_power": total_power_kw
    }


# ============================================================
# ENERGY MODEL
# ============================================================

def usable_battery_energy_kwh(vehicle: Vehicle) -> float:
    """
    Usable battery energy.
    """

    return (
        vehicle.battery_energy_kwh
        * vehicle.battery_usable_fraction
    )


def endurance_hours(
    vehicle: Vehicle,
    power_kw: float
) -> float:

    if power_kw <= 0:
        return float("inf")

    energy = usable_battery_energy_kwh(vehicle)

    return energy / power_kw


def range_km(
    velocity_mps: float,
    endurance_h: float
) -> float:

    velocity_kmh = velocity_mps * 3.6

    return velocity_kmh * endurance_h


# ============================================================
# VELOCITY SWEEP
# ============================================================

def generate_velocity_array(
    minimum=1.0,
    maximum=50.0,
    points=200
):

    return np.linspace(
        minimum,
        maximum,
        points
    )


def analyze_mode(
    vehicle: Vehicle,
    env: Environment,
    mode: str,
    velocities
):

    results = []

    for v in velocities:

        if mode == "flight":
            result = flight_performance(
                vehicle,
                v,
                env
            )

        elif mode == "surface":
            result = surface_performance(
                vehicle,
                v,
                env
            )

        elif mode == "underwater":
            result = underwater_performance(
                vehicle,
                v,
                env
            )

        else:
            raise ValueError(
                "Mode must be flight, surface, or underwater."
            )

        power = result["electrical_power"]

        endurance = endurance_hours(
            vehicle,
            power
        )

        distance = range_km(
            v,
            endurance
        )

        result["endurance_h"] = endurance
        result["range_km"] = distance

        results.append(result)

    return results


# ============================================================
# CSV EXPORT
# ============================================================

def save_results_csv(
    results,
    filename
):

    if not results:
        return

    path = Path(filename)

    keys = results[0].keys()

    with open(
        path,
        "w",
        newline=""
    ) as file:

        writer = csv.DictWriter(
            file,
            fieldnames=keys
        )

        writer.writeheader()

        for row in results:
            writer.writerow(row)

    print(f"Saved: {path}")



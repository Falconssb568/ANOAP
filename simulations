<script>


// ============================================================
// CONSTANTS
// ============================================================

const G = 9.80665;

const AIR_DENSITY = 1.225;

const WATER_DENSITY = 1025;


// ============================================================
// CHART STORAGE
// ============================================================

let powerChart;
let dragChart;
let enduranceChart;
let rangeChart;

let simulationData = [];


// ============================================================
// GET VEHICLE PARAMETERS
// ============================================================

function getVehicle() {

    return {

        mass:
            Number(
                document.getElementById("mass").value
            ),

        length:
            Number(
                document.getElementById("length").value
            ),

        width:
            Number(
                document.getElementById("width").value
            ),

        height:
            Number(
                document.getElementById("height").value
            ),

        wingArea:
            Number(
                document.getElementById("wingArea").value
            ),

        cdAir:
            Number(
                document.getElementById("cdAir").value
            ),

        cdSurface:
            Number(
                document.getElementById("cdSurface").value
            ),

        cdWater:
            Number(
                document.getElementById("cdWater").value
            ),

        airArea:
            Number(
                document.getElementById("airArea").value
            ),

        waterArea:
            Number(
                document.getElementById("waterArea").value
            ),

        volume:
            Number(
                document.getElementById("volume").value
            ),

        battery:
            Number(
                document.getElementById("battery").value
            )

    };

}


// ============================================================
// BASIC PHYSICS
// ============================================================

function weight(vehicle) {

    return vehicle.mass * G;

}


function buoyancy(vehicle) {

    return (
        WATER_DENSITY *
        G *
        vehicle.volume
    );

}


function drag(
    density,
    velocity,
    cd,
    area
) {

    return (
        0.5 *
        density *
        velocity *
        velocity *
        cd *
        area
    );

}


// ============================================================
// FLIGHT MODEL
// ============================================================

function flightModel(
    vehicle,
    velocity
) {

    if (velocity <= 0) {

        return {

            power: 0,
            drag: 0,
            lift: 0,
            cl: Infinity,
            endurance: 0,
            range: 0

        };

    }


    const W =
        weight(vehicle);


    const denominator =
        0.5 *
        AIR_DENSITY *
        velocity *
        velocity *
        vehicle.wingArea;


    const cl =
        W / denominator;


    const lift =
        0.5 *
        AIR_DENSITY *
        velocity *
        velocity *
        vehicle.wingArea *
        cl;


    const D =
        drag(
            AIR_DENSITY,
            velocity,
            vehicle.cdAir,
            vehicle.airArea
        );


    const mechanicalPower =
        D * velocity;


    const efficiency = 0.65;


    const electricalPower =
        mechanicalPower /
        efficiency /
        1000;


    const totalPower =
        electricalPower +
        0.15;


    const usableEnergy =
        vehicle.battery * 0.9;


    const endurance =
        usableEnergy /
        totalPower;


    const range =
        velocity *
        3.6 *
        endurance;


    return {

        power: totalPower,

        drag: D,

        lift: lift,

        cl: cl,

        endurance: endurance,

        range: range

    };

}


// ============================================================
// SURFACE MODEL
// ============================================================

function surfaceModel(
    vehicle,
    velocity
) {

    const D =
        drag(
            WATER_DENSITY,
            velocity,
            vehicle.cdSurface,
            vehicle.waterArea
        );


    const mechanicalPower =
        D * velocity;


    const electricalPower =
        mechanicalPower /
        0.55 /
        1000;


    const totalPower =
        electricalPower +
        0.15;


    const usableEnergy =
        vehicle.battery * 0.9;


    const endurance =
        usableEnergy /
        totalPower;


    const range =
        velocity *
        3.6 *
        endurance;


    return {

        power: totalPower,

        drag: D,

        endurance: endurance,

        range: range

    };

}


// ============================================================
// UNDERWATER MODEL
// ============================================================

function underwaterModel(
    vehicle,
    velocity
) {

    const D =
        drag(
            WATER_DENSITY,
            velocity,
            vehicle.cdWater,
            vehicle.waterArea
        );


    const mechanicalPower =
        D * velocity;


    const electricalPower =
        mechanicalPower /
        0.50 /
        1000;


    const totalPower =
        electricalPower +
        0.15;


    const usableEnergy =
        vehicle.battery * 0.9;


    const endurance =
        usableEnergy /
        totalPower;


    const range =
        velocity *
        3.6 *
        endurance;


    return {

        power: totalPower,

        drag: D,

        endurance: endurance,

        range: range

    };

}


// ============================================================
// MAIN SIMULATION
// ============================================================

function runSimulation() {


    const vehicle =
        getVehicle();


    const minVelocity =
        Number(
            document.getElementById(
                "minVelocity"
            ).value
        );


    const maxVelocity =
        Number(
            document.getElementById(
                "maxVelocity"
            ).value
        );


    const points =
        Number(
            document.getElementById(
                "points"
            ).value
        );


    const W =
        weight(vehicle);


    const B =
        buoyancy(vehicle);


    document.getElementById(
        "weight"
    ).textContent =
        W.toFixed(2);


    document.getElementById(
        "buoyancy"
    ).textContent =
        B.toFixed(2);


    document.getElementById(
        "displacement"
    ).textContent =
        vehicle.volume.toFixed(3);


    document.getElementById(
        "batteryOutput"
    ).textContent =
        vehicle.battery.toFixed(2);


    document.getElementById(
        "usableEnergy"
    ).textContent =
        (
            vehicle.battery * 0.9
        ).toFixed(2);


    if (B > W) {

        document.getElementById(
            "floatStatus"
        ).textContent =
            "✓ POSITIVE BUOYANCY — vehicle tends to float.";

    }

    else if (B < W) {

        document.getElementById(
            "floatStatus"
        ).textContent =
            "⚠ NEGATIVE BUOYANCY — vehicle tends to sink.";

    }

    else {

        document.getElementById(
            "floatStatus"
        ).textContent =
            "⚖ NEUTRAL BUOYANCY.";

    }


    simulationData = [];


    let velocities = [];

    let flightPower = [];
    let surfacePower = [];
    let underwaterPower = [];

    let flightDrag = [];
    let surfaceDrag = [];
    let underwaterDrag = [];

    let flightEndurance = [];
    let surfaceEndurance = [];
    let underwaterEndurance = [];

    let flightRange = [];
    let surfaceRange = [];
    let underwaterRange = [];


    for (
        let i = 0;
        i < points;
        i++
    ) {

        const v =
            minVelocity +
            (
                maxVelocity -
                minVelocity
            ) *
            (
                i /
                (points - 1)
            );


        const flight =
            flightModel(
                vehicle,
                v
            );


        const surface =
            surfaceModel(
                vehicle,
                v
            );


        const underwater =
            underwaterModel(
                vehicle,
                v
            );


        velocities.push(v);


        flightPower.push(
            flight.power
        );

        surfacePower.push(
            surface.power
        );

        underwaterPower.push(
            underwater.power
        );


        flightDrag.push(
            flight.drag
        );

        surfaceDrag.push(
            surface.drag
        );

        underwaterDrag.push(
            underwater.drag
        );


        flightEndurance.push(
            flight.endurance
        );

        surfaceEndurance.push(
            surface.endurance
        );

        underwaterEndurance.push(
            underwater.endurance
        );


        flightRange.push(
            flight.range
        );

        surfaceRange.push(
            surface.range
        );

        underwaterRange.push(
            underwater.range
        );


        simulationData.push({

            velocity: v,

            flightPower:
                flight.power,

            surfacePower:
                surface.power,

            underwaterPower:
                underwater.power,

            flightDrag:
                flight.drag,

            surfaceDrag:
                surface.drag,

            underwaterDrag:
                underwater.drag,

            flightEndurance:
                flight.endurance,

            surfaceEndurance:
                surface.endurance,

            underwaterEndurance:
                underwater.endurance,

            flightRange:
                flight.range,

            surfaceRange:
                surface.range,

            underwaterRange:
                underwater.range

        });

    }


    createCharts(
        velocities,
        flightPower,
        surfacePower,
        underwaterPower,
        flightDrag,
        surfaceDrag,
        underwaterDrag,
        flightEndurance,
        surfaceEndurance,
        underwaterEndurance,
        flightRange,
        surfaceRange,
        underwaterRange
    );


    updateOptimalTable();

}


// ============================================================
// CHART CREATION
// ============================================================

function createCharts(

    velocities,

    flightPower,
    surfacePower,
    underwaterPower,

    flightDrag,
    surfaceDrag,
    underwaterDrag,

    flightEndurance,
    surfaceEndurance,
    underwaterEndurance,

    flightRange,
    surfaceRange,
    underwaterRange

) {


    if (powerChart)
        powerChart.destroy();

    if (dragChart)
        dragChart.destroy();

    if (enduranceChart)
        enduranceChart.destroy();

    if (rangeChart)
        rangeChart.destroy();


    powerChart =
        new Chart(
            document.getElementById(
                "powerChart"
            ),
            {

                type: "line",

                data: {

                    labels:
                        velocities,

                    datasets: [

                        {
                            label: "Flight",
                            data: flightPower,
                            borderWidth: 2
                        },

                        {
                            label: "Surface",
                            data: surfacePower,
                            borderWidth: 2
                        },

                        {
                            label: "Underwater",
                            data: underwaterPower,
                            borderWidth: 2
                        }

                    ]

                },

                options: {

                    responsive: true,

                    scales: {

                        x: {
                            title: {
                                display: true,
                                text: "Velocity (m/s)"
                            }
                        },

                        y: {
                            title: {
                                display: true,
                                text: "Power (kW)"
                            }
                        }

                    }

                }

            }
        );


    dragChart =
        new Chart(
            document.getElementById(
                "dragChart"
            ),
            {

                type: "line",

                data: {

                    labels:
                        velocities,

                    datasets: [

                        {
                            label: "Flight",
                            data: flightDrag,
                            borderWidth: 2
                        },

                        {
                            label: "Surface",
                            data: surfaceDrag,
                            borderWidth: 2
                        },

                        {
                            label: "Underwater",
                            data: underwaterDrag,
                            borderWidth: 2
                        }

                    ]

                },

                options: {

                    responsive: true

                }

            }
        );


    enduranceChart =
        new Chart(
            document.getElementById(
                "enduranceChart"
            ),
            {

                type: "line",

                data: {

                    labels:
                        velocities,

                    datasets: [

                        {
                            label: "Flight",
                            data: flightEndurance,
                            borderWidth: 2
                        },

                        {
                            label: "Surface",
                            data: surfaceEndurance,
                            borderWidth: 2
                        },

                        {
                            label: "Underwater",
                            data: underwaterEndurance,
                            borderWidth: 2
                        }

                    ]

                },

                options: {

                    responsive: true

                }

            }
        );


    rangeChart =
        new Chart(
            document.getElementById(
                "rangeChart"
            ),
            {

                type: "line",

                data: {

                    labels:
                        velocities,

                    datasets: [

                        {
                            label: "Flight",
                            data: flightRange,
                            borderWidth: 2
                        },

                        {
                            label: "Surface",
                            data: surfaceRange,
                            borderWidth: 2
                        },

                        {
                            label: "Underwater",
                            data: underwaterRange,
                            borderWidth: 2
                        }

                    ]

                },

                options: {

                    responsive: true

                }

            }
        );

}


// ============================================================
// FIND OPTIMAL POINT
// ============================================================

function minimum(
    array,
    property
) {

    return array.reduce(

        (best, current) => {

            if (
                current[property] <
                best[property]
            ) {

                return current;

            }

            return best;

        }

    );

}


// ============================================================
// UPDATE TABLE
// ============================================================

function updateOptimalTable() {


    if (
        simulationData.length === 0
    ) {

        return;

    }


    const flight =
        simulationData.map(
            x => ({

                velocity: x.velocity,
                power: x.flightPower,
                endurance: x.flightEndurance,
                range: x.flightRange

            })
        );


    const surface =
        simulationData.map(
            x => ({

                velocity: x.velocity,
                power: x.surfacePower,
                endurance: x.surfaceEndurance,
                range: x.surfaceRange

            })
        );


    const underwater =
        simulationData.map(
            x => ({

                velocity: x.velocity,
                power: x.underwaterPower,
                endurance: x.underwaterEndurance,
                range: x.underwaterRange

            })
        );


    const bestFlight =
        minimum(
            flight,
            "power"
        );


    const bestSurface =
        minimum(
            surface,
            "power"
        );


    const bestUnderwater =
        minimum(
            underwater,
            "power"
        );


    const table =
        document.getElementById(
            "optimalTable"
        );


    table.innerHTML = "";


    addRow(
        table,
        "Flight",
        bestFlight
    );


    addRow(
        table,
        "Surface",
        bestSurface
    );


    addRow(
        table,
        "Underwater",
        bestUnderwater
    );

}


function addRow(
    table,
    name,
    data
) {

    const row =
        table.insertRow();


    row.innerHTML = `

        <td>${name}</td>

        <td>
            ${data.velocity.toFixed(2)}
            m/s
        </td>

        <td>
            ${data.power.toFixed(3)}
            kW
        </td>

        <td>
            ${data.endurance.toFixed(2)}
            h
        </td>

        <td>
            ${data.range.toFixed(2)}
            km
        </td>

    `;

}


// ============================================================
// MISSION SIMULATION
// ============================================================

function runMission() {


    const vehicle =
        getVehicle();


    let remaining =
        vehicle.battery * 0.9;


    let totalDistance = 0;

    let totalEnergy = 0;


    const segments = [

        {

            name:
                "Initial Flight",

            mode:
                "flight",

            velocity:
                Number(
                    document.getElementById(
                        "flightVelocity"
                    ).value
                ),

            time:
                Number(
                    document.getElementById(
                        "flightTime"
                    ).value
                )

        },


        {

            name:
                "Ocean Surface",

            mode:
                "surface",

            velocity:
                Number(
                    document.getElementById(
                        "surfaceVelocity"
                    ).value
                ),

            time:
                Number(
                    document.getElementById(
                        "surfaceTime"
                    ).value
                )

        },


        {

            name:
                "Underwater Survey",

            mode:
                "underwater",

            velocity:
                Number(
                    document.getElementById(
                        "underwaterVelocity"
                    ).value
                ),

            time:
                Number(
                    document.getElementById(
                        "underwaterTime"
                    ).value
                )

        },


        {

            name:
                "Return Flight",

            mode:
                "flight",

            velocity:
                Number(
                    document.getElementById(
                        "flightVelocity"
                    ).value
                ),

            time:
                Number(
                    document.getElementById(
                        "returnTime"
                    ).value
                )

        }

    ];


    let report = "";


    for (
        const segment of segments
    ) {


        let result;


        if (
            segment.mode ===
            "flight"
        ) {

            result =
                flightModel(
                    vehicle,
                    segment.velocity
                );

        }

        else if (
            segment.mode ===
            "surface"
        ) {

            result =
                surfaceModel(
                    vehicle,
                    segment.velocity
                );

        }

        else {

            result =
                underwaterModel(
                    vehicle,
                    segment.velocity
                );

        }


        const energy =
            result.power *
            segment.time;


        const distance =
            segment.velocity *
            3.6 *
            segment.time;


        remaining -= energy;

        totalEnergy += energy;

        totalDistance += distance;


        report += `

            <p>

            <strong>
            ${segment.name}
            </strong>

            <br>

            Power:
            ${result.power.toFixed(3)}
            kW

            <br>

            Energy:
            ${energy.toFixed(3)}
            kWh

            <br>

            Distance:
            ${distance.toFixed(2)}
            km

            <br>

            Remaining:
            ${remaining.toFixed(3)}
            kWh

            </p>

        `;

    }


    document.getElementById(
        "missionDistance"
    ).textContent =
        totalDistance.toFixed(2);


    document.getElementById(
        "missionEnergy"
    ).textContent =
        totalEnergy.toFixed(2);


    document.getElementById(
        "remainingEnergy"
    ).textContent =
        remaining.toFixed(2);


    document.getElementById(
        "missionReport"
    ).innerHTML = `

        ${report}

        <hr>

        <strong>
        Total Distance:
        ${totalDistance.toFixed(2)}
        km
        </strong>

        <br>

        <strong>
        Total Energy:
        ${totalEnergy.toFixed(2)}
        kWh
        </strong>

        <br>

        <strong>
        Remaining Energy:
        ${remaining.toFixed(2)}
        kWh
        </strong>

    `;

}


// ============================================================
// CSV EXPORT
// ============================================================

function downloadCSV() {


    if (
        simulationData.length === 0
    ) {

        alert(
            "Run the simulation first."
        );

        return;

    }


    const headers = [

        "Velocity",

        "Flight Power",

        "Surface Power",

        "Underwater Power",

        "Flight Drag",

        "Surface Drag",

        "Underwater Drag",

        "Flight Endurance",

        "Surface Endurance",

        "Underwater Endurance",

        "Flight Range",

        "Surface Range",

        "Underwater Range"

    ];


    let csv =
        headers.join(",") +
        "\n";


    simulationData.forEach(
        row => {

            csv += [

                row.velocity,

                row.flightPower,

                row.surfacePower,

                row.underwaterPower,

                row.flightDrag,

                row.surfaceDrag,

                row.underwaterDrag,

                row.flightEndurance,

                row.surfaceEndurance,

                row.underwaterEndurance,

                row.flightRange,

                row.surfaceRange,

                row.underwaterRange

            ].join(",") +
            "\n";

        }
    );


    const blob =
        new Blob(
            [csv],
            {
                type:
                    "text/csv"
            }
        );


    const url =
        URL.createObjectURL(
            blob
        );


    const a =
        document.createElement(
            "a"
        );


    a.href = url;

    a.download =
        "ANOAP_simulation.csv";

    a.click();


    URL.revokeObjectURL(
        url
    );

}



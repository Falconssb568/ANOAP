# ============================================================
# VEHICLE REPORT
# ============================================================

def print_vehicle_report(
    vehicle: Vehicle,
    env: Environment
):

    weight = vehicle_weight(
        vehicle,
        env
    )

    buoyancy = buoyancy_force(
        vehicle,
        env
    )

    usable_energy = usable_battery_energy_kwh(
        vehicle
    )

    print()
    print("=" * 60)
    print("ANOAP VEHICLE REPORT")
    print("=" * 60)

    print(f"Mass:                 {vehicle.mass_kg:.2f} kg")
    print(f"Length:               {vehicle.length_m:.2f} m")
    print(f"Width:                {vehicle.width_m:.2f} m")
    print(f"Height:               {vehicle.height_m:.2f} m")
    print(f"Wing area:            {vehicle.wing_area_m2:.2f} m²")

    print()
    print(f"Weight:               {weight:.2f} N")
    print(f"Buoyancy:             {buoyancy:.2f} N")

    if buoyancy > weight:
        print("Float condition:      POSITIVE BUOYANCY")
    elif abs(buoyancy - weight) < 1e-6:
        print("Float condition:      NEUTRAL")
    else:
        print("Float condition:      NEGATIVE BUOYANCY")

    print()
    print(f"Battery:              {vehicle.battery_energy_kwh:.2f} kWh")
    print(f"Usable battery:       {usable_energy:.2f} kWh")

    print("=" * 60)
    print()


# ============================================================
# FIND BEST OPERATING POINT
# ============================================================

def find_minimum_power_point(results):

    valid = [
        x for x in results
        if math.isfinite(x["electrical_power"])
        and x["electrical_power"] > 0
    ]

    if not valid:
        return None

    return min(
        valid,
        key=lambda x: x["electrical_power"]
    )


def print_best_points(
    flight,
    surface,
    underwater
):

    modes = {
        "FLIGHT": flight,
        "SURFACE": surface,
        "UNDERWATER": underwater
    }

    print()
    print("=" * 60)
    print("MINIMUM POWER OPERATING POINTS")
    print("=" * 60)

    for name, data in modes.items():

        best = find_minimum_power_point(data)

        if best is None:
            continue

        print()
        print(name)

        print(
            f"Velocity:   {best['velocity']:.2f} m/s"
        )

        print(
            f"Power:      {best['electrical_power']:.3f} kW"
        )

        print(
            f"Endurance:  {best['endurance_h']:.2f} h"
        )

        print(
            f"Range:      {best['range_km']:.2f} km"
        )

    print("=" * 60)


# ============================================================
# TRANSITION ENERGY
# ============================================================

def transition_energy(
    vehicle: Vehicle,
    transition_time_seconds: float,
    average_power_kw: float
) -> float:

    """
    Simplified transition energy:

        E = P * t

    Returns kWh.
    """

    hours = transition_time_seconds / 3600

    return average_power_kw * hours


# ============================================================
# MISSION SIMULATION
# ============================================================

@dataclass
class MissionSegment:
    name: str
    mode: str
    velocity_mps: float
    duration_hours: float


def simulate_mission(
    vehicle: Vehicle,
    env: Environment,
    mission
):

    remaining_energy = usable_battery_energy_kwh(
        vehicle
    )

    print()
    print("=" * 60)
    print("MISSION SIMULATION")
    print("=" * 60)

    total_distance = 0.0
    total_time = 0.0

    for segment in mission:

        if segment.mode == "flight":

            result = flight_performance(
                vehicle,
                segment.velocity_mps,
                env
            )

        elif segment.mode == "surface":

            result = surface_performance(
                vehicle,
                segment.velocity_mps,
                env
            )

        elif segment.mode == "underwater":

            result = underwater_performance(
                vehicle,
                segment.velocity_mps,
                env
            )

        else:
            raise ValueError(
                f"Unknown mode: {segment.mode}"
            )

        power = result["electrical_power"]

        energy_used = (
            power
            * segment.duration_hours
        )

        distance = (
            segment.velocity_mps
            * 3.6
            * segment.duration_hours
        )

        remaining_energy -= energy_used

        total_distance += distance
        total_time += segment.duration_hours

        print()
        print(f"Segment: {segment.name}")
        print(f"Mode: {segment.mode}")
        print(
            f"Velocity: {segment.velocity_mps:.2f} m/s"
        )
        print(
            f"Duration: {segment.duration_hours:.2f} h"
        )
        print(
            f"Power: {power:.3f} kW"
        )
        print(
            f"Energy used: {energy_used:.3f} kWh"
        )
        print(
            f"Distance: {distance:.2f} km"
        )
        print(
            f"Remaining energy: "
            f"{remaining_energy:.3f} kWh"
        )

        if remaining_energy < 0:

            print()
            print("WARNING:")
            print("MISSION EXCEEDED AVAILABLE ENERGY.")
            break

    print()
    print("=" * 60)
    print("MISSION SUMMARY")
    print("=" * 60)

    print(
        f"Total mission time: "
        f"{total_time:.2f} h"
    )

    print(
        f"Total distance: "
        f"{total_distance:.2f} km"
    )

    print(
        f"Remaining energy: "
        f"{remaining_energy:.3f} kWh"
    )

    print("=" * 60)


# ============================================================
# MAIN PROGRAM
# ============================================================

def main():

    # --------------------------------------------------------
    # CREATE VEHICLE
    # --------------------------------------------------------

    vehicle = Vehicle(
        mass_kg=25.0,

        length_m=2.0,
        width_m=0.8,
        height_m=0.35,

        wing_area_m2=1.5,

        cd_air=0.08,

        cl_max=1.2,

        cd_surface=0.06,

        cd_underwater=0.35,

        frontal_area_air_m2=0.25,

        frontal_area_water_m2=0.28,

        propulsive_efficiency_air=0.65,

        propulsive_efficiency_surface=0.55,

        propulsive_efficiency_underwater=0.50,

        battery_energy_kwh=20.0,

        battery_usable_fraction=0.90,

        hotel_power_kw=0.15,

        displacement_volume_m3=0.20
    )

    # --------------------------------------------------------
    # ENVIRONMENT
    # --------------------------------------------------------

    env = Environment(
        air_density=1.225,
        water_density=1025.0,
        gravity=9.80665
    )

    # --------------------------------------------------------
    # REPORT
    # --------------------------------------------------------

    print_vehicle_report(
        vehicle,
        env
    )

    # --------------------------------------------------------
    # VELOCITY RANGE
    # --------------------------------------------------------

    velocities = generate_velocity_array(
        minimum=1.0,
        maximum=50.0,
        points=200
    )

    # --------------------------------------------------------
    # RUN SIMULATIONS
    # --------------------------------------------------------

    flight_results = analyze_mode(
        vehicle,
        env,
        "flight",
        velocities
    )

    surface_results = analyze_mode(
        vehicle,
        env,
        "surface",
        velocities
    )

    underwater_results = analyze_mode(
        vehicle,
        env,
        "underwater",
        velocities
    )

    # --------------------------------------------------------
    # SAVE DATA
    # --------------------------------------------------------

    save_results_csv(
        flight_results,
        "anoap_flight_results.csv"
    )

    save_results_csv(
        surface_results,
        "anoap_surface_results.csv"
    )

    save_results_csv(
        underwater_results,
        "anoap_underwater_results.csv"
    )

    # --------------------------------------------------------
    # BEST OPERATING POINTS
    # --------------------------------------------------------

    print_best_points(
        flight_results,
        surface_results,
        underwater_results
    )

    # --------------------------------------------------------
    # PLOTS
    # --------------------------------------------------------

    plot_power(
        velocities,
        flight_results,
        surface_results,
        underwater_results
    )

    plot_drag(
        velocities,
        flight_results,
        surface_results,
        underwater_results
    )

    plot_endurance(
        velocities,
        flight_results,
        surface_results,
        underwater_results
    )

    plot_range(
        velocities,
        flight_results,
        surface_results,
        underwater_results
    )

    # --------------------------------------------------------
    # EXAMPLE MISSION
    # --------------------------------------------------------

    mission = [

        MissionSegment(
            name="Atmospheric cruise",
            mode="flight",
            velocity_mps=20.0,
            duration_hours=1.0
        ),

        MissionSegment(
            name="Ocean surface transit",
            mode="surface",
            velocity_mps=5.0,
            duration_hours=1.0
        ),

        MissionSegment(
            name="Underwater survey",
            mode="underwater",
            velocity_mps=2.0,
            duration_hours=2.0
        ),

        MissionSegment(
            name="Return flight",
            mode="flight",
            velocity_mps=20.0,
            duration_hours=1.0
        )
    ]

    simulate_mission(
        vehicle,
        env,
        mission
    )

    print()
    print("ANOAP simulation complete.")


# ============================================================
# PROGRAM ENTRY POINT
# ============================================================

if __name__ == "__main__":
    main()
